# Copy to apps/web/.env.local (never commit .env.local, passwords, or secret keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Transaction pooler for serverless. Percent-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PERCENT-ENCODED-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Session pooler for migrations (not the IPv6-only db.* host unless you have IPv6)
DIRECT_URL=postgresql://postgres.your-project-ref:[YOUR-PERCENT-ENCODED-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# F19 Google Drive / Workspace SOURCE ingestion (server-only OAuth access token).
# Selective file IDs or one-level folder listing only; never a company-wide recursive crawl.
# Drive is the human/source workspace. Bytes are copied into the Supabase Storage evidence vault.
# Leave unset for fixture acceptance only; the Intake page shows an explicit live blocker.
# GOOGLE_DRIVE_ACCESS_TOKEN=
# F8 WORKING_PROPOSAL_OUTPUT is a separate module and direction. Optional Docs-specific
# token wins there; it is never used by F19 SOURCE_INGEST.
# GOOGLE_DOCS_ACCESS_TOKEN=
# Approved user staging folders for selective F19 SOURCE ingestion:
#   Test Documents  16OAYM97haJkn2zyBnKnh7L8RouSqtGfc
#   Platform        1_I4Kt4uKTSX0934q6mJEErNLKz8yxYvF
# Upload helper: python scripts/upload-pilot-acquired-to-drive.py  (GOOGLE_DRIVE_FOLDER_ID optional)
# Set to 1 only to skip Vercel Workflow start and mark documents QUEUED inline.
# WORKFLOW_INLINE=
# Local FastAPI processor for parse/extract (do not deploy on Vercel; web-only deploy).
# Read by the WEB app to reach services/processor. Unset = no parse/extract is dispatched.
# PROCESSOR_URL=http://127.0.0.1:8080
# Shared secret sent as the x-processor-secret header; must match the processor's env.
# PROCESSOR_SHARED_SECRET=dev-processor-secret
# Mistral OCR for SCANNED PDFs (mean extractable chars/page < 40). Read by the PROCESSOR,
# which also loads this file. Leave UNSET to keep OCR off: scanned PDFs then fail closed with
# lifecycle_error prefixed "OCR_REQUIRED:" instead of being silently stored as an empty parse.
# Only set this when you accept per-page OCR API cost. See docs/ROUTING_POLICY.md.
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# Intake byte gate is code, not env: MAX_INTAKE_BYTES = 50 MB in apps/web/lib/intake/allowed-files.ts.
# The processor imposes no byte limit of its own (it downloads from the vault).
# Ask GPT dual-rail agent — providers (NO Grok). Prefer one chat path:
# ASK_MODEL=openai/gpt-4o-mini
# ASK_MODEL=groq/llama-3.3-70b-versatile
# ASK_MODEL=ollama/llama3.2
# ASK_MODEL=google/gemini-3.6-flash
# Vercel AI Gateway (preferred hosted path; needs billing card for free credits):
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-4o-mini
# Groq:
# GROQ_API_KEY=
# Local Ollama (free; tool-calling may be weak):
# OLLAMA_ENABLED=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_HOST=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# Google Gemini (public-ok for non-secret corpus work; still prefer Gateway/Groq for prod):
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=
# Optional direct OpenAI (quota/cost; Gateway preferred):
# OPENAI_API_KEY=
# Optional embeddings via AI Gateway/OpenAI (FTS works without this; must stay 1536-d).
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_VERSION=1
# Public research rail (Morphic-style; cite-only — NEVER written to document_chunks):
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Public opportunity discovery (Pursuits → Discover). Unset = clearly labeled SAMPLE FIXTURES,
# not live notices. Set to search live SAM.gov. Public notices are never HUMAN_VERIFIED.
# SAM_GOV_API_KEY=
# SAM_API_KEY=
# ChatGPT Pro Custom GPT Actions (Bearer secret for /api/ask/actions/*):
# GPT_ACTIONS_SECRET=
# Public app URL for OpenAPI servers[] (ChatGPT Actions import):
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Lasting operator (global admin). Never commit the password.
# Local `next dev` auto-signs in with these. Agents/scripts use the same account.
# LP_OPERATOR_EMAIL=you@example.com
# LP_OPERATOR_PASSWORD=
# LP_OPERATOR_ORG_NAME=L&P Global Security
