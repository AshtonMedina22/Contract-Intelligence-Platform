{
  "name": "contract-intelligence-platform",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "env:check": "node --env-file=apps/web/.env.local scripts/env-check.mjs",
    "report:corpus-funnel": "node --env-file=apps/web/.env.local scripts/corpus-funnel-report.mjs",
    "test:f1-ingestion": "node --env-file=apps/web/.env.local scripts/f1-production-ingestion-acceptance.mjs",
    "test:f2-opportunity-engine": "node --env-file=apps/web/.env.local scripts/f2-opportunity-engine-acceptance.mjs",
    "test:f3-federal-awards": "node --env-file=apps/web/.env.local scripts/f3-federal-awards-acceptance.mjs",
    "test:processor": "python -m pytest -q --rootdir=services/processor services/processor/tests",
    "test:verify2a": "node scripts/verify2a-corpus-audit.mjs",
    "test:verify2b": "node scripts/verify2b-pilot-acceptance.mjs",
    "test:verify2c": "node --env-file=apps/web/.env.local scripts/verify2c-schema-acceptance.mjs",
    "test:verify3": "node --env-file=apps/web/.env.local scripts/verify3-data-ops-acceptance.mjs",
    "test:verify4": "node --env-file=apps/web/.env.local scripts/verify4-contract-lifecycle-acceptance.mjs",
    "test:verify5": "node --env-file=apps/web/.env.local scripts/verify5-intelligence-acceptance.mjs",
    "test:verify6": "node --env-file=apps/web/.env.local scripts/verify6-ask-reports-automation-acceptance.mjs",
    "test:verify7": "node --env-file=apps/web/.env.local scripts/verify7-pricing-acceptance.mjs",
    "test:verify8": "node --env-file=apps/web/.env.local scripts/verify8-proposal-workflow-acceptance.mjs",
    "test:pilot2b": "node --env-file=apps/web/.env.local scripts/phase2-pilot-run.mjs && node scripts/phase2-pilot-gap-report.mjs && node scripts/verify2b-pilot-acceptance.mjs",
    "test:verify1": "node --env-file=apps/web/.env.local scripts/verify1-architecture.mjs && node --env-file=apps/web/.env.local scripts/verify1-foundation-acceptance.mjs",
    "test:foundation": "npm run env:check && npm run test:phase2-rls && npm run test:phase3-intake && npm run test:phase5-verification && npm run test:processor && npm run test:verify1",
    "test:phase2c-schema": "node --env-file=apps/web/.env.local scripts/phase2c-schema-acceptance.mjs",
    "test:phase2-rls": "node --env-file=apps/web/.env.local scripts/phase2-rls-acceptance.mjs",
    "test:phase3-intake": "node --env-file=apps/web/.env.local scripts/phase3-intake-acceptance.mjs",
    "test:phase3-production": "node --env-file=apps/web/.env.local scripts/phase3-production-acceptance.mjs",
    "test:phase3": "npm run test:phase3-intake && npm run test:phase3-production && npm run test:phase8-bulk && npm run test:phase5-verification && npm run test:phase7-four-truth && npm run test:phase11-hybrid-rag && npm run test:processor",
    "test:phase5-verification": "node scripts/phase5-verification-acceptance.mjs",
    "test:phase6-benchmark": "node scripts/phase6-benchmark.mjs",
    "test:phase7-four-truth": "node --env-file=apps/web/.env.local scripts/phase7-four-truth-acceptance.mjs",
    "test:phase7-pricing": "node --env-file=apps/web/.env.local scripts/phase7-pricing-intelligence-acceptance.mjs",
    "test:phase8-response": "node --env-file=apps/web/.env.local scripts/phase8-response-submission-acceptance.mjs",
    "test:phase8-bulk": "node --env-file=apps/web/.env.local scripts/phase8-bulk-migration-acceptance.mjs",
    "test:phase9-contracts": "node --env-file=apps/web/.env.local scripts/phase9-contracts-acceptance.mjs",
    "test:phase4-contracts": "node --env-file=apps/web/.env.local scripts/phase4-contracts-acceptance.mjs",
    "test:phase5-intelligence": "node --env-file=apps/web/.env.local scripts/phase5-intelligence-acceptance.mjs",
    "test:phase6-ask": "node --env-file=apps/web/.env.local scripts/phase6-ask-reports-automation-acceptance.mjs",
    "test:phase10-win-loss": "node --env-file=apps/web/.env.local scripts/phase10-win-loss-acceptance.mjs",
    "test:phase11-hybrid-rag": "node --env-file=apps/web/.env.local scripts/phase11-hybrid-rag-acceptance.mjs",
    "test:p4-discovery": "node scripts/p4-public-discovery-acceptance.mjs",
    "test:p4-discovery-rls": "node --env-file=apps/web/.env.local scripts/p4-public-sources-rls.mjs",
    "test:p5-pursuit-strategy": "node scripts/p5-pursuit-strategy-acceptance.mjs",
    "test:p6-response-workspace": "node scripts/p6-response-workspace-acceptance.mjs",
    "test:p7-pricing-workbench": "node scripts/p7-pricing-workbench-acceptance.mjs",
    "test:p8-submission-result": "node scripts/p8-submission-result-acceptance.mjs",
    "test:p9-intelligence-workbench": "node scripts/p9-intelligence-workbench-acceptance.mjs",
    "test:p10-contracts-renewal": "node scripts/p10-contracts-renewal-acceptance.mjs"
  }
}
