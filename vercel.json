{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm install --prefix ../.."
    }
  },
  "crons": [
    {
      "path": "/api/cron/intelligence-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/public-opportunity-sync",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
