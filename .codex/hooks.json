{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook session-start --client cursor"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook activity-start --client cursor"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "MCP:(bdt|ndt|pdt|bedt|adt|tdt)_.*",
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook require-verification --client cursor --soft"
          }
        ]
      },
      {
        "matcher": "Write|StrReplace|Delete",
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook require-verdict --client cursor --soft"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook block-subagent --client cursor"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|StrReplace|Delete",
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook clear-verdict --client cursor"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook track-action --client cursor"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ironbee hook activity-end --client cursor"
          }
        ]
      }
    ]
  }
}
